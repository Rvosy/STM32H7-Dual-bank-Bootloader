STM32_OPENOCD_INTERFACE=stlink
STM32_OPENOCD_TARGET=${workspaceFolder}/.eide/stm32h7x_dual_boot
STM32_OPENOCD_BASE_ADDR=0x08000000
STM32_BUILD_SYSTEM=eide
STM32_BUILD_DIR=EIDE\build\Bootloader
STM32_BUILD_TOOLCHAIN=AC5
STM32_RTT_SYMBOL=_SEGGER_RTT
STM32_RTT_SCAN_WINDOW=0x24000000:0x00080000
