STM32_PROFILE_VERSION=1.0.0
STM32_PROFILE_DIR=.claude/bfd
STM32_PROFILE_JSON=.claude/bfd/active_profile.json
STM32_PROFILE_ENV=.claude/bfd/active_profile.env
STM32_PROFILE_LEGACY_DIR=.codex/stm32/bootstrap
STM32_PROFILE_LEGACY_JSON=.codex/stm32/bootstrap/active_profile.json
STM32_PROFILE_LEGACY_ENV=.codex/stm32/bootstrap/active_profile.env
STM32_PROFILE_FINGERPRINT=d478e5a40a89894eeab269e7e0ee5f7b6801c91c2aad837075c26a6b4517d11b
STM32_PROFILE_FINGERPRINT_VERSION=1
STM32_IOC_JSON_DIR=.claude/bfd/ioc_json
STM32_PROFILE_OVERRIDES_ENV=.claude/bfd/profile_overrides.env
STM32_PROJECT_ROOT=.
STM32_IOC=Bootloader.ioc
STM32_FAMILY=STM32H7
STM32_DEVICE=STM32H743IITx
STM32_IF=SWD
STM32_SPEED_KHZ=8000
STM32_PROBE=openocd
STM32_ELF=EIDE\build\Bootloader\Bootloader.elf
STM32_HEX=EIDE\build\Bootloader\Bootloader.hex
STM32_MAP=EIDE\build\Bootloader\Bootloader.map
